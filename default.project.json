{
  "name": "MAYHEM X",
  "serveAddress": "127.0.0.1",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "MaterialService": { "$className": "MaterialService", "MayhemDeck": { "$path": "assets/art/MayhemDeck.rbxmx" } },
    "StarterGui": { "$className": "StarterGui", "$properties": { "ScreenOrientation": "Sensor" } },
    "Workspace": {
      "$className": "Workspace",
      "$properties": { "Gravity": 196.2, "FallenPartsDestroyHeight": -100, "StreamingEnabled": false },
      "MayhemWorld": { "$className": "Folder", "EditorPreview": { "$path": "build/generated/Maps/Collapse.rbxmx" } }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": { "ClockTime": 13.5, "Brightness": 2.5, "Ambient": [0.58, 0.69, 0.78], "OutdoorAmbient": [0.64, 0.74, 0.81] }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Mayhem": {
        "$className": "Folder",
        "Art": { "$path": "assets/art/Library.rbxmx" },
        "Shared": { "$path": "src/shared", "MapCatalog": { "$path": "build/generated/MapCatalog.luau" } },
        "Presentation": { "$className": "RemoteEvent" },
        "ClientChecks": { "$path": "tests/ClientTests.luau" },
        "Remotes": {
          "$className": "Folder",
          "Action": { "$className": "RemoteEvent" },
          "State": { "$className": "RemoteEvent" },
          "Effect": { "$className": "RemoteEvent" },
          "Feed": { "$className": "RemoteEvent" }
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "MayhemServer": { "$path": "src/server" },
      "MayhemTests": {
        "$path": "tests/StudioTests.luau",
        "RulesCases": { "$path": "tests/RulesCases.luau" },
        "VisualCases": { "$path": "tests/VisualCases.luau" },
        "StyleCases": { "$path": "tests/StyleCases.luau" },
        "MapRulesCases": { "$path": "tests/MapRulesCases.luau" },
        "PreferenceCases": { "$path": "tests/PreferenceCases.luau" },
		"ProfileCases": { "$path": "tests/ProfileCases.luau" },
        "AudioCases": { "$path": "tests/AudioCases.luau" }
      }
    },
    "ServerStorage": { "$className":"ServerStorage", "MapTemplates": { "$path":"build/generated/Maps" } },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": { "CameraMinZoomDistance": 0.5, "CameraMaxZoomDistance": 16, "EnableMouseLockOption": false },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "MayhemClient": { "$path": "src/client" }
      }
    },
    "SoundService": { "$className": "SoundService", "$properties": { "RespectFilteringEnabled": true } }
  }
}
